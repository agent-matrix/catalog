          },
          {
            "description": "Read-only root filesystem \u2014 the server writes nothing locally.",
            "name": "--read-only",
            "type": "named"
          },
          {
            "description": "Drop all Linux capabilities.",
            "name": "--cap-drop",
            "type": "named",
            "value": "ALL"
          },
          {
            "description": "Block privilege escalation.",
            "name": "--security-opt",
            "type": "named",
            "value": "no-new-privileges"
          },
          {
            "description": "Memory limit for the server process itself.",
            "name": "--memory",
