  "name": "io.github.zepgram/toyota",
  "packages": [
    {
      "environmentVariables": [
        {
          "description": "MyToyota account email",
          "isRequired": true,
          "name": "TOYOTA_USERNAME"
        },
        {
          "description": "MyToyota account password",
          "isRequired": true,
          "isSecret": true,
          "name": "TOYOTA_PASSWORD"
        },
        {
          "description": "VIN selector when several vehicles share the account",
          "name": "TOYOTA_VIN"
        },
        {
          "description": "T for Toyota (default), L for Lexus",
          "name": "TOYOTA_BRAND"
        },
        {
          "description": "true (default) for km/L, false for miles/gallons",
          "name": "TOYOTA_USE_METRIC"
        }
      ],
      "identifier": "toyota-mcp",
      "packageArguments": [
        {
          "description": "register only the read tools",
          "name": "--read-only",
          "type": "named"
        },
        {
          "description": "osm (worldwide addresses) or fr (French addresses and fuel prices)",
          "name": "--addresses",
          "type": "named",
          "valueHint": "osm"
        },
        {
          "description": "named places, e.g. home=43.6045,1.4440;work=43.6290,1.3630",
          "name": "--places",
          "type": "named",
          "valueHint": "home=lat,lon"
        }
      ],
